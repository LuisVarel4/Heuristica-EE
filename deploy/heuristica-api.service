[Unit]
Description=Heuristica EE API
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/heuristica-ee/backend
EnvironmentFile=/opt/heuristica-ee/backend/.env
ExecStart=/opt/heuristica-ee/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
