DATABASE_PATH=data/heuristica.db
CLOUD_FUNCTION_URL=https://REGION-PROJECT.cloudfunctions.net/run_evolution
# Set true to skip HTTP and run the algorithm inside the API (no Cloud Function needed)
RUN_EVOLUTION_LOCALLY=false
ADMIN_KEY=heuristica-ee
CLOUD_FUNCTION_TIMEOUT_SECONDS=30
COOLDOWN_SECONDS=30
LEADERBOARD_LIMIT=50
CORS_ORIGINS=*
